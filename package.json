{
  "name": "structured-wiki-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "wiki",
    "wiki-models",
    "wiki-server",
    "wiki-mcp",
    "wiki-mirror"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w wiki -w wiki-models -w wiki-server -w wiki-mcp -w wiki-mirror",
    "test": "npm run test -w wiki -w wiki-models -w wiki-server -w wiki-mcp -w wiki-mirror",
    "build": "npm run build -w wiki -w wiki-models -w wiki-server -w wiki-mcp -w wiki-mirror",
    "start": "npm run start:server",
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm:start:server\" \"npm:start:ui\"",
    "start:server": "npm run start:all -w wiki-server",
    "start:mirror": "tsx wiki-mirror/src/bin.ts",
    "start:ui": "npm run dev --prefix wiki-ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
